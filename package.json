{
  "name": "better-result-db-errors",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Database failures as better-result tagged errors — Result<T, DbError>, driver-agnostic, retry-aware.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown src/index.ts && tsc -p tsconfig.build.json",
    "test": "bun test ./test.db-result.ts ./test.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-result": "^3.0.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "^1.3.14",
    "@types/pg": "^8.20.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "1.0.0-rc.4",
    "miniflare": "^5.20260801.0-alpha",
    "pg": "^8.13.0",
    "postgres": "^3.4.9",
    "tsdown": "^0.2.0",
    "typescript": "^5.6.0"
  }
}
